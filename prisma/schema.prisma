generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER  @map("owner")
  EDITOR @map("editor")
  VIEWER @map("viewer")

  @@map("member_role")
}

enum StoreType {
  LOCAL  @map("local")
  ONLINE @map("online")

  @@map("store_type")
}

enum ListItemStatus {
  OPEN      @map("open")
  IN_CART   @map("in_cart")
  PURCHASED @map("purchased")
  CANCELLED @map("cancelled")

  @@map("list_item_status")
}

enum CartStatus {
  ACTIVE      @map("active")
  CHECKED_OUT @map("checked_out")
  CANCELLED   @map("cancelled")

  @@map("cart_status")
}

enum AttributeValueType {
  TEXT    @map("text")
  NUMBER  @map("number")
  BOOLEAN @map("boolean")

  @@map("attribute_value_type")
}

model User {
  id          String            @id @default(uuid()) @db.Uuid
  oidcSubject String            @unique @map("oidc_subject")
  email       String            @unique
  name        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  memberships HouseholdMember[]
  masterItems MasterItem[]

  @@map("users")
}

model Household {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  members   HouseholdMember[]
  lists     ShoppingList[]
  stores    Store[]
  items     MasterItem[]
  carts     Cart[]
  purchases Purchase[]

  @@map("households")
}

model HouseholdMember {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(EDITOR)
  createdAt   DateTime   @default(now()) @map("created_at")
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model ShoppingList {
  id          String             @id @default(uuid()) @db.Uuid
  householdId String             @map("household_id") @db.Uuid
  name        String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]
  carts       Cart[]

  @@index([householdId, updatedAt])
  @@map("shopping_lists")
}

model Store {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  name        String
  type        StoreType  @default(LOCAL)
  address     String?
  url         String?
  notes       String?
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  carts       Cart[]
  purchases   Purchase[]

  @@index([householdId, name])
  @@map("stores")
}

model MasterItem {
  id             String                @id @default(uuid()) @db.Uuid
  householdId    String                @map("household_id") @db.Uuid
  createdById    String                @map("created_by_id") @db.Uuid
  name           String
  normalizedName String                @map("normalized_name")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  household      Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation(fields: [createdById], references: [id])
  listItems      ShoppingListItem[]
  cartItems      CartItem[]
  purchaseItems  PurchaseItem[]
  attributes     MasterItemAttribute[]

  @@index([householdId, normalizedName])
  @@map("master_items")
}

model ShoppingListItem {
  id           String                      @id @default(uuid()) @db.Uuid
  listId       String                      @map("list_id") @db.Uuid
  masterItemId String?                     @map("master_item_id") @db.Uuid
  name         String
  status       ListItemStatus              @default(OPEN)
  checkedAt    DateTime?                   @map("checked_at")
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  list         ShoppingList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  masterItem   MasterItem?                 @relation(fields: [masterItemId], references: [id], onDelete: SetNull)
  cartItems    CartItem[]
  attributes   ShoppingListItemAttribute[]

  @@index([listId, status])
  @@map("shopping_list_items")
}

model Cart {
  id           String       @id @default(uuid()) @db.Uuid
  householdId  String       @map("household_id") @db.Uuid
  listId       String       @map("list_id") @db.Uuid
  storeId      String?      @map("store_id") @db.Uuid
  status       CartStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  checkedOutAt DateTime?    @map("checked_out_at")
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  list         ShoppingList @relation(fields: [listId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items        CartItem[]
  purchase     Purchase?

  @@index([listId, status])
  @@index([householdId, status])
  @@map("carts")
}

model CartItem {
  id           String              @id @default(uuid()) @db.Uuid
  cartId       String              @map("cart_id") @db.Uuid
  listItemId   String?             @map("list_item_id") @db.Uuid
  masterItemId String?             @map("master_item_id") @db.Uuid
  name         String
  cart         Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listItem     ShoppingListItem?   @relation(fields: [listItemId], references: [id], onDelete: SetNull)
  masterItem   MasterItem?         @relation(fields: [masterItemId], references: [id], onDelete: SetNull)
  purchaseItem PurchaseItem?
  attributes   CartItemAttribute[]

  @@unique([cartId, listItemId])
  @@map("cart_items")
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  cartId      String         @unique @map("cart_id") @db.Uuid
  storeId     String?        @map("store_id") @db.Uuid
  purchasedAt DateTime       @default(now()) @map("purchased_at")
  currency    String         @default("KRW")
  totalPrice  Decimal?       @map("total_price") @db.Decimal(12, 2)
  notes       String?
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  cart        Cart           @relation(fields: [cartId], references: [id])
  store       Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items       PurchaseItem[]

  @@index([householdId, purchasedAt])
  @@map("purchases")
}

model PurchaseItem {
  id           String                  @id @default(uuid()) @db.Uuid
  purchaseId   String                  @map("purchase_id") @db.Uuid
  cartItemId   String                  @unique @map("cart_item_id") @db.Uuid
  masterItemId String?                 @map("master_item_id") @db.Uuid
  name         String
  purchase     Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  cartItem     CartItem                @relation(fields: [cartItemId], references: [id])
  masterItem   MasterItem?             @relation(fields: [masterItemId], references: [id], onDelete: SetNull)
  attributes   PurchaseItemAttribute[]

  @@map("purchase_items")
}

model MasterItemAttribute {
  id           String             @id @default(uuid()) @db.Uuid
  masterItemId String             @map("master_item_id") @db.Uuid
  attributeKey String             @map("attribute_key")
  value        String
  valueType    AttributeValueType @default(TEXT) @map("value_type")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  masterItem   MasterItem         @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([masterItemId, attributeKey])
  @@map("master_item_attributes")
}

model ShoppingListItemAttribute {
  id                 String             @id @default(uuid()) @db.Uuid
  shoppingListItemId String             @map("shopping_list_item_id") @db.Uuid
  attributeKey       String             @map("attribute_key")
  value              String
  valueType          AttributeValueType @default(TEXT) @map("value_type")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  shoppingListItem   ShoppingListItem   @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)

  @@unique([shoppingListItemId, attributeKey])
  @@map("shopping_list_item_attributes")
}

model CartItemAttribute {
  id           String             @id @default(uuid()) @db.Uuid
  cartItemId   String             @map("cart_item_id") @db.Uuid
  attributeKey String             @map("attribute_key")
  value        String
  valueType    AttributeValueType @default(TEXT) @map("value_type")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  cartItem     CartItem           @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, attributeKey])
  @@map("cart_item_attributes")
}

model PurchaseItemAttribute {
  id             String             @id @default(uuid()) @db.Uuid
  purchaseItemId String             @map("purchase_item_id") @db.Uuid
  attributeKey   String             @map("attribute_key")
  value          String
  valueType      AttributeValueType @default(TEXT) @map("value_type")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  purchaseItem   PurchaseItem       @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@unique([purchaseItemId, attributeKey])
  @@map("purchase_item_attributes")
}
