DATABASE_URL=postgresql://pantry:pantry_local_dev@localhost:5432/pantrypal
DIRECT_URL=postgresql://pantry:pantry_local_dev@localhost:5432/pantrypal
AUTH_SECRET=replace-with-a-long-random-value
OIDC_ISSUER_URL=https://identity.example.com/realms/pantry
OIDC_CLIENT_ID=pantry-pal
OIDC_CLIENT_SECRET=replace-me
OIDC_TOKEN_URL=https://your-cognito-domain.auth.ap-northeast-2.amazoncognito.com/oauth2/token
OIDC_USERINFO_URL=https://your-cognito-domain.auth.ap-northeast-2.amazoncognito.com/oauth2/userInfo
# Cognito logout uses this domain. If omitted, it is derived from OIDC_USERINFO_URL.
# COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-northeast-2.amazoncognito.com
OIDC_SCOPE=openid profile email
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Seoul
DEFAULT_CURRENCY=KRW
# RabbitMQ receipt delivery
RABBITMQ_URL=amqp://pantry:replace-me@rabbitmq:5672
RABBITMQ_RECEIPT_EXCHANGE=pantry-pal.receipts
RABBITMQ_RECEIPT_QUEUE=pantry-pal.receipt-worker
RABBITMQ_RECEIPT_ROUTING_KEY=receipt.email
RECEIPT_INTERNAL_TOKEN=replace-with-a-long-random-value
RECEIPT_API_URL=http://pantry-pal:3000
# SMTP settings used only by the receipt worker
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pantry Pal <receipts@example.com>
# OpenTelemetry traces are sent to the GitOps-provided OTLP/HTTP collector.
OTEL_SERVICE_NAME=pantry-pal
# The OTLP/HTTP exporter appends /v1/traces when needed.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,k8s.namespace.name=pantry
# OTEL_TRACES_SAMPLER=parentbased_always_on
